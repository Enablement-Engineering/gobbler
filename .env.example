# Gobbler Environment Variables
# Copy this file to .env and customize as needed

# =============================================================================
# Model & Cache Configuration
# =============================================================================

# Model cache directory for Whisper, Docling, etc.
# Default: ~/.gobbler/models
GOBBLER_MODELS_PATH=${HOME}/.gobbler/models

# =============================================================================
# Service URLs (Docker Services)
# =============================================================================

# Crawl4AI service URL for web scraping with JavaScript rendering
CRAWL4AI_URL=http://localhost:11235

# Crawl4AI API token for authentication (change in production!)
CRAWL4AI_API_TOKEN=gobbler-local-token

# Docling service URL for document conversion
DOCLING_URL=http://localhost:5001

# =============================================================================
# Redis Configuration (Job Queue)
# =============================================================================

# Redis host and port for background job queue
REDIS_HOST=localhost
REDIS_PORT=6380

# Redis URL (alternative to host/port)
REDIS_URL=redis://localhost:6380/0

# Redis password (optional, for production)
# REDIS_PASSWORD=your-secure-password

# Redis database number
REDIS_DB=0

# =============================================================================
# Worker Configuration
# =============================================================================

# Number of RQ workers to spawn
GOBBLER_WORKER_COUNT=1

# Queue names to process (comma-separated)
GOBBLER_QUEUES=default,transcription,download

# Job timeout in seconds (default: 1 hour)
GOBBLER_JOB_TIMEOUT=3600

# Job result TTL in seconds (default: 24 hours)
GOBBLER_RESULT_TTL=86400

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
GOBBLER_LOG_LEVEL=INFO

# Log format (json, text)
GOBBLER_LOG_FORMAT=text

# Log file path (optional, logs to stdout by default)
# GOBBLER_LOG_FILE=/var/log/gobbler/gobbler.log

# =============================================================================
# YouTube Configuration
# =============================================================================

# YouTube cookies file for authenticated requests (optional)
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# YouTube rate limiting (requests per minute)
YOUTUBE_RATE_LIMIT=30

# YouTube download quality (best, 1080p, 720p, 480p, 360p)
YOUTUBE_DEFAULT_QUALITY=best

# =============================================================================
# Audio Transcription (Whisper)
# =============================================================================

# Default Whisper model size (tiny, base, small, medium, large)
WHISPER_DEFAULT_MODEL=small

# Whisper compute type (int8, float16, float32)
WHISPER_COMPUTE_TYPE=int8

# Whisper device (auto, cpu, cuda, mps)
WHISPER_DEVICE=auto

# =============================================================================
# Web Crawling Configuration
# =============================================================================

# Default crawl delay in seconds (polite crawling)
CRAWL_DELAY=1.0

# Maximum concurrent crawl requests
CRAWL_MAX_CONCURRENCY=3

# Respect robots.txt (true/false)
CRAWL_RESPECT_ROBOTS=true

# Default user agent for crawling
# CRAWL_USER_AGENT=Gobbler/1.0 (+https://github.com/Enablement-Engineering/gobbler)

# =============================================================================
# Metrics & Monitoring (Optional)
# =============================================================================

# Enable Prometheus metrics endpoint
GOBBLER_METRICS_ENABLED=false

# Metrics server port
GOBBLER_METRICS_PORT=9090

# =============================================================================
# Browser Extension (WebSocket Relay)
# =============================================================================

# WebSocket relay port for browser extension
GOBBLER_RELAY_PORT=8765

# WebSocket relay host
GOBBLER_RELAY_HOST=localhost
