{
  "manifest_version": 3,
  "name": "Gobbler",
  "version": "0.2.33",
  "description": "Extract, navigate, and automate tabs in Gobbler's managed browser group",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger",
    "tabGroups",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "ws://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
